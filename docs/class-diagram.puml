@startuml
' Library monolith - DAO pattern option 4
' controller -> service -> DAO interfaces <- ORMLite adapters -> model/database
' Stage 1: BaseDao.transaction, LocalDate fields with LocalDatePersister, LoanPolicy, NotFoundException
' Stage 2: service-owned lending, shared Clock, inventory delegation, and service-only controllers

skin rose
' left to right direction

skinparam package<<controller>> {
  BackgroundColor #FCE4EC
  BorderColor #D81B60
}
skinparam package<<service>> {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
}
skinparam package<<dao>> {
  BackgroundColor #E8F5E9
  BorderColor #388E3C
}
skinparam package<<model>> {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
}
skinparam package<<db>> {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
}
hide stereotype

package "controller" <<controller>> {
  class BookController {
    - BookService service
    + BookController(BookService)
    + register(JavalinConfig) : void
  }

  class LoanController {
    - LoanService loanService
    + LoanController(LoanService)
    + register(JavalinConfig) : void
  }

  class MemberController {
    - MemberService service
    + MemberController(MemberService)
    + register(JavalinConfig) : void
  }

  class ReservationController {
    - ReservationService service
    + ReservationController(ReservationService)
    + register(JavalinConfig) : void
  }
}

package "service" <<service>> {
  class BookService {
    - BookDao dao
    + BookService(BookDao)
    + listAll() : List<Book>
    + findById(int) : Book
    + create(Book) : Book
    + borrow(int) : void
    + returnCopy(int) : void
  }

  class LoanService {
    - LoanDao loanDao
    - MemberDao memberDao
    - BookService bookService
    - Clock clock
    + LoanService(LoanDao, MemberDao, BookService, Clock)
    + findAll() : List<Loan>
    + checkout(int memberId, int bookId) : Loan throws SQLException
    + returnLoan(int loanId) : Loan throws SQLException
    + overdueLoans() : List<Loan>
    - withAccruedFees(List<Loan> loans) : List<Loan>
    - accruedFee(Loan loan, LocalDate today) : double
  }

  class MemberService {
    - MemberDao memberDao
    + MemberService(MemberDao)
    + register(Member) : Member
    + findAll() : List<Member>
  }

  class ReservationService {
    - ReservationDao reservationDao
    - MemberDao memberDao
    - LoanDao loanDao
    - BookService bookService
    - Clock clock
    + ReservationService(ReservationDao, MemberDao, LoanDao, BookService, Clock)
    + reserve(int bookId, int memberId) : Reservation
    + findAll() : List<Reservation>
    + fulfill(int reservationId) : Loan throws SQLException
  }

  class LoanPolicy {
    + {static} int DUE_DAYS = 21
    + {static} double FEE_PER_DAY = 1.0
    - LoanPolicy()
    + {static} dueDate(LocalDate) : LocalDate
  }

  class NotFoundException {
    + NotFoundException(String)
  }
}

package "dao" <<dao>> {
  interface "CrudDao<T>" as CrudDao {
    + findAll() : List<T>
    + findById(Integer) : T
    + create(T) : void
    + update(T) : void
    + delete(T) : void
    + transaction(Callable<R>) : R
  }

  interface BookDao
  interface MemberDao
  interface LoanDao
  interface ReservationDao

  abstract class "BaseDao<T>" as BaseDao {
    # Dao<T, Integer> dao
    + findAll() : List<T>
    + findById(Integer) : T
    + create(T) : void
    + update(T) : void
    + delete(T) : void
    + transaction(Callable<R>) : R
  }

  class OrmLiteBookDao
  class OrmLiteMemberDao
  class OrmLiteLoanDao
  class OrmLiteReservationDao

  BookDao --|> CrudDao
  MemberDao --|> CrudDao
  LoanDao --|> CrudDao
  ReservationDao --|> CrudDao

  BaseDao ..|> CrudDao
  OrmLiteBookDao --|> BaseDao
  OrmLiteMemberDao --|> BaseDao
  OrmLiteLoanDao --|> BaseDao
  OrmLiteReservationDao --|> BaseDao

  OrmLiteBookDao ..|> BookDao
  OrmLiteMemberDao ..|> MemberDao
  OrmLiteLoanDao ..|> LoanDao
  OrmLiteReservationDao ..|> ReservationDao
}

package "model" <<model>> {
  class Book {
    - int id
    - String title
    - String author
    - String isbn
    - int totalCopies
    - int availableCopies
    + Book()
    + Book(String, String, String, int)
    + getId() : int
    + setId(int) : void
    + getTitle() : String
    + setTitle(String) : void
    + getAuthor() : String
    + setAuthor(String) : void
    + getIsbn() : String
    + setIsbn(String) : void
    + getTotalCopies() : int
    + setTotalCopies(int) : void
    + getAvailableCopies() : int
    + setAvailableCopies(int) : void
  }

  class Member {
    - int id
    - String name
    - String email
    + Member()
    + Member(String, String)
    + getId() : int
    + setId(int) : void
    + getName() : String
    + setName(String) : void
    + getEmail() : String
    + setEmail(String) : void
  }

  class Loan {
    - int id
    - Member member
    - Book book
    - LocalDate loanDate
    - LocalDate dueDate
    - LocalDate returnDate
    - boolean returned
    - double overdueFee
    + Loan()
    + Loan(Member, Book, LocalDate, LocalDate)
    + getId() : int
    + setId(int) : void
    + getMember() : Member
    + setMember(Member) : void
    + getBook() : Book
    + setBook(Book) : void
    + getLoanDate() : LocalDate
    + setLoanDate(LocalDate) : void
    + getDueDate() : LocalDate
    + setDueDate(LocalDate) : void
    + getReturnDate() : LocalDate
    + setReturnDate(LocalDate) : void
    + isReturned() : boolean
    + setReturned(boolean) : void
    + getOverdueFee() : double
    + setOverdueFee(double) : void
  }

  class Reservation {
    - int id
    - Member member
    - Book book
    - LocalDate reservedAt
    - boolean fulfilled
    + Reservation()
    + Reservation(Member, Book, LocalDate)
    + getId() : int
    + setId(int) : void
    + getMember() : Member
    + setMember(Member) : void
    + getBook() : Book
    + setBook(Book) : void
    + getReservedAt() : LocalDate
    + setReservedAt(LocalDate) : void
    + isFulfilled() : boolean
    + setFulfilled(boolean) : void
  }
}

package "db" <<db>> {
  class Database {
    - ConnectionSource connectionSource
    + connectionSource() : ConnectionSource
    + seedIfEmpty() : void
  }

  class LocalDatePersister {
    - {static} LocalDatePersister SINGLETON
    - LocalDatePersister()
    + {static} getSingleton() : LocalDatePersister
    + parseDefaultString(FieldType, String) : Object
    + resultToSqlArg(FieldType, DatabaseResults, int) : Object
    + sqlArgToJava(FieldType, Object, int) : Object
    + javaToSqlArg(FieldType, Object) : Object
  }
}

' ----- external supertypes and injected infrastructure -----
abstract class BaseDataType
class RuntimeException
abstract class "java.time.Clock" as Clock
interface "com.j256.ormlite.support.ConnectionSource" as ConnectionSource

' ----- controllers depend only on services -----
BookController "1" --> "1" BookService
LoanController "1" --> "1" LoanService
MemberController "1" --> "1" MemberService
ReservationController "1" --> "1" ReservationService

' ----- services use DAO interfaces, guarded inventory, and injected clocks -----
BookService "1" --> "1" BookDao
LoanService "1" --> "1" LoanDao
LoanService "1" --> "1" MemberDao
LoanService "1" --> "1" BookService
LoanService "1" --> "1" Clock
MemberService "1" --> "1" MemberDao
ReservationService "1" --> "1" ReservationDao
ReservationService "1" --> "1" MemberDao
ReservationService "1" --> "1" LoanDao
ReservationService "1" --> "1" BookService
ReservationService "1" --> "1" Clock

' ----- concrete persistence adapters -----
OrmLiteBookDao "1" --> "0..*" Book
OrmLiteMemberDao "1" --> "0..*" Member
OrmLiteLoanDao "1" --> "0..*" Loan
OrmLiteReservationDao "1" --> "0..*" Reservation
BaseDao ..> ConnectionSource : constructor parameter
Database "1" --> "1" ConnectionSource

' ----- shared policy, domain errors, and typed dates -----
LoanService ..> LoanPolicy : dueDate / FEE_PER_DAY
ReservationService ..> LoanPolicy : dueDate
BookService ..> NotFoundException : throws
LoanService ..> NotFoundException : throws
ReservationService ..> NotFoundException : throws
NotFoundException --|> RuntimeException
LocalDatePersister --|> BaseDataType
Loan ..> LocalDatePersister : persists dates
Reservation ..> LocalDatePersister : persists reservedAt

' ----- model relationships -----
Loan "0..*" --> "1" Member
Loan "0..*" --> "1" Book
Reservation "0..*" --> "1" Member
Reservation "0..*" --> "1" Book

@enduml
